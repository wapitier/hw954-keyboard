#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        login_sequence: login_sequence {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&macro_tap &kp SPACE &kp N3 &kp N2 &kp N6 &kp N2>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &login_sequence
                &kp LA(F4)
                &kp F16
                &kp F13
                &kp F14
                &kp F15
                &kp UP
                &kp DOWN
                &kp LEFT
                &kp RIGHT
                &kp RET
                &kp C_VOL_UP
                &kp C_VOL_DN
                &kp PG_UP
                &kp PG_DN
                &kp BSPC
                &kp SPACE
            >;
        };
    };
};
